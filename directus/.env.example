####################################################################################################
## Directus Backend Configuration
####################################################################################################

# Database
DB_CLIENT="pg"
DB_HOST="database"
DB_PORT="5432"
DB_DATABASE="directus"
DB_USER="directus"
DB_PASSWORD="directus"

# Security Keys (generate new ones for production!)
KEY="255d861b-5ea1-5996-9aa3-922530ec40b1"
SECRET="6116487b-cda1-52c2-b5b5-c8022c45e263"

# Admin Account (change for production!)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin"

# Public URL
PUBLIC_URL="http://localhost:8055"

# CORS (add your production domains)
CORS_ENABLED="true"
CORS_ORIGIN="http://localhost:8000,http://localhost:3000,https://www.successchemistry.com"

# Cache
CACHE_ENABLED="true"
CACHE_STORE="redis"
REDIS="redis://cache:6379"

# Rate Limiting
RATE_LIMITER_ENABLED="true"
RATE_LIMITER_POINTS="50"
RATE_LIMITER_DURATION="1"

# Email (configure for production)
# EMAIL_FROM="noreply@successchemistry.com"
# EMAIL_TRANSPORT="smtp"
# EMAIL_SMTP_HOST="smtp.example.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER="smtp_user"
# EMAIL_SMTP_PASSWORD="smtp_password"

# File Storage (configure for production with S3/Cloudinary)
# STORAGE_LOCATIONS="s3"
# STORAGE_S3_DRIVER="s3"
# STORAGE_S3_KEY="your-s3-key"
# STORAGE_S3_SECRET="your-s3-secret"
# STORAGE_S3_BUCKET="your-bucket"
# STORAGE_S3_REGION="us-east-1"
