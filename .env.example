# Medusa Backend (optional – for cart/checkout)
NEXT_PUBLIC_MEDUSA_URL=https://your-medusa.fly.dev

# PayPal (optional – defaults to Success Chemistry PocketBase)
NEXT_PUBLIC_API_BASE=https://success-chemistry-pb.fly.dev
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# ========== Google tracking (see TRACKING_AND_TAGS.md for full doc) ==========
# GA4 – used for page_view, view_item, view_item_list, add_to_cart, begin_checkout, purchase, generate_lead
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads – required for conversion tracking and tag visibility in Diagnostics
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXX
# Optional: from Goals → Conversions → Tag setup (e.g. AbC123XyZ)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# GTM – if set, load GTM instead of direct gtag; add GA4/Ads inside GTM
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
