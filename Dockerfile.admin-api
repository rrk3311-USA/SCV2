# Admin API Server (PayPal, ShipStation, PocketBase orders)
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production deps only (skip dev/optional for smaller image)
RUN npm ci --only=production --ignore-scripts

# Copy admin API source
COPY admin-api-server.js ./
COPY api/ ./api/

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["node", "admin-api-server.js"]
